# MedliNER local environment. This file contains paths and safe defaults only.
# Run `direnv allow` once after reviewing it.

watch_file .envrc.local
source_env_if_exists .envrc.local

export MEDLINER_EXPORT_BUNDLE="${MEDLINER_EXPORT_BUNDLE:-$PWD/data/dakp-export}"
# Override these in the ignored `.envrc.local` when using a separately exported DAKP directory.
export MEDLINER_BENCHMARK="${MEDLINER_BENCHMARK:-$PWD/data/materialized/ingested/ner_gold.json}"
export MEDLINER_RAW_CANDIDATES="${MEDLINER_RAW_CANDIDATES:-$PWD/data/label-studio/candidates.ndjson}"
export MEDLINER_LABEL_STUDIO_EXPORT="${MEDLINER_LABEL_STUDIO_EXPORT:-$PWD/data/label-studio/reviewed.json}"
export MEDLINER_ONBOARDING_CONFIG="${MEDLINER_ONBOARDING_CONFIG:-$PWD/configs/onboarding.json}"
export MEDLINER_ONBOARDING_EXPORT="${MEDLINER_ONBOARDING_EXPORT:-$PWD/data/materialized/onboarding/export.json}"
# `make train` enables the gate; leave this unset so unit tests and data preparation stay legacy-compatible.
export MEDLINER_WORKDIR="${MEDLINER_WORKDIR:-$PWD/data/materialized}"
export MEDLINER_TRAIN_CONFIG="${MEDLINER_TRAIN_CONFIG:-$PWD/configs/train-small.yaml}"
# Local LLM (Ornith-1.0-9B via llama-server), used only by the opt-in `medliner shorten` stage.
export MEDLINER_LLM_URL="${MEDLINER_LLM_URL:-http://127.0.0.1:8080}"
# Pre-labeling checkpoint and score floor: the same model and threshold the sibling DAKP
# pipeline mines contraindications with, so suggestions here match what DAKP already extracts.
export MEDLINER_PRELABEL_MODEL="${MEDLINER_PRELABEL_MODEL:-gliner-community/gliner_large-v2.5}"
export MEDLINER_PRELABEL_THRESHOLD="${MEDLINER_PRELABEL_THRESHOLD:-0.35}"
export MEDLINER_LABEL_STUDIO_PORT="${MEDLINER_LABEL_STUDIO_PORT:-9030}"
export MEDLINER_LABEL_STUDIO_IMAGE="${MEDLINER_LABEL_STUDIO_IMAGE:-docker.io/heartexlabs/label-studio:latest}"
export MEDLINER_LABEL_STUDIO_USERNAME="${MEDLINER_LABEL_STUDIO_USERNAME:-medliner@localhost}"
export MEDLINER_LABEL_STUDIO_PASSWORD="${MEDLINER_LABEL_STUDIO_PASSWORD:-medliner-local}"
# Bind address for the Label Studio port mapping; 0.0.0.0 exposes it on the LAN for group sessions.
export MEDLINER_LABEL_STUDIO_HOST="${MEDLINER_LABEL_STUDIO_HOST:-127.0.0.1}"

# Triton finds libcuda by shelling out to /sbin/ldconfig. On systems without a loader cache
# that call raises FileNotFoundError in the middle of the backward pass, so point Triton at the
# driver directory instead. An empty value is ignored by Triton and restores the default lookup.
if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ ! -x /sbin/ldconfig ]; then
  for candidate in /run/opengl-driver/lib /usr/lib64 /usr/lib/x86_64-linux-gnu /usr/lib; do
    if [ -e "$candidate/libcuda.so.1" ]; then
      export TRITON_LIBCUDA_PATH="$candidate"
      break
    fi
  done
fi
