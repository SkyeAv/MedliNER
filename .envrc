# MEDliNER local environment. This file contains paths and safe defaults only.
# Run `direnv allow` once after reviewing it.

watch_file .envrc.local
source_env_if_exists .envrc.local

export MEDLINER_LABEL_STUDIO_EXPORT="${MEDLINER_LABEL_STUDIO_EXPORT:-$PWD/data/label-studio/reviewed.json}"
export MEDLINER_WORKDIR="${MEDLINER_WORKDIR:-$PWD/data/materialized}"
export MEDLINER_TRAIN_CONFIG="${MEDLINER_TRAIN_CONFIG:-$PWD/configs/train-small.yaml}"
export MEDLINER_DAKP_ROOT="${MEDLINER_DAKP_ROOT:-$PWD/../DAKP}"
export DAGSTER_HOME="${DAGSTER_HOME:-$PWD/.dagster}"

# Triton finds libcuda by shelling out to /sbin/ldconfig. On systems without a loader cache
# that call raises FileNotFoundError in the middle of the backward pass, so point Triton at the
# driver directory instead. An empty value is ignored by Triton and restores the default lookup.
if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ ! -x /sbin/ldconfig ]; then
  for candidate in /run/opengl-driver/lib /usr/lib64 /usr/lib/x86_64-linux-gnu /usr/lib; do
    if [ -e "$candidate/libcuda.so.1" ]; then
      export TRITON_LIBCUDA_PATH="$candidate"
      break
    fi
  done
fi
